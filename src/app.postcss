@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;

html,
body {
	@apply h-full overflow-hidden;
}

a.netlify-identity-button {
	@apply btn;
	@apply variant-filled-secondary;
}

@layer components {
	.dstl-nodebase {
		@apply flex flex-col max-w-[800px] max-h-[600px] border w-full border-solid border-gray-200 h-full rounded-2xl bg-surface-200/70 shadow-[0_7px_9px_0_rgba(0,0,0,0.02)];
	}

	.dstl-nodetitle {
		@apply text-xs flex px-3 py-2 border-b border-solid border-gray-200 font-mono font-semibold rounded-t-2xl text-[#0F172A]
	}

	.dstl-nodeslot {
		@apply relative bg-surface-100 p-3 flex-1 min-h-0 rounded-b-2xl font-sans text-xs 
	}

	.dstl-highlight {
		@apply border border-solid border-red-500 border-4;
	}
}

/* Bottom-left workspace controls ---------------------------------------------------- */

/* The flow library paints every control icon solid (fill: currentColor), which turns our
   outline icons into blobs. Draw them as outlines instead, and a little larger. */
button.dstl-ctrl svg {
	fill: none;
	stroke: currentColor;
	max-width: 16px;
	max-height: 16px;
}

/* The "?" help button is plain text so it is always clearly visible */
button.dstl-help {
	font-size: 16px;
	font-weight: 700;
	line-height: 1;
}

/* Quick hover tooltip that appears to the right of the button */
button.dstl-ctrl[data-tip] {
	position: relative;
}
button.dstl-ctrl[data-tip]:hover::after,
button.dstl-ctrl[data-tip]:focus-visible::after {
	content: attr(data-tip);
	position: absolute;
	left: calc(100% + 8px);
	top: 50%;
	transform: translateY(-50%);
	z-index: 50;
	padding: 4px 8px;
	border-radius: 6px;
	background: #0f172a;
	color: #fff;
	font-size: 11px;
	font-weight: 500;
	line-height: 1.2;
	white-space: nowrap;
	pointer-events: none;
}
